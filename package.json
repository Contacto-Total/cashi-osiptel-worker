{
  "name": "cashi-osiptel-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker que valida titularidad telefónica contra el portal de Osiptel mediante Playwright + 2Captcha. Pertenece al sistema Cashi (Fase 1 standalone).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/sensible": "^5.6.0",
    "playwright": "^1.49.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
