# Puerto HTTP del worker
PORT=8090

# Token compartido. El backend Java debe enviarlo en X-Worker-Token.
WORKER_TOKEN=change-me-shared-secret

# reCAPTCHA v3: el worker genera el token con el grecaptcha nativo del portal
# (Chromium de Playwright ejecuta grecaptcha.execute). Sin servicio externo
# ni API key — gratis. El score lo asigna Google segun el comportamiento.

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_BUDGET_MS=90000

# Pool
WORKER_POOL_SIZE=3
WORKER_RECYCLE_AFTER=50

# Circuit breaker para bans
BAN_THRESHOLD=5
BAN_COOLDOWN_MS=600000

# Proxies (opcional, separados por coma)
PROXY_LIST=

# Logging
LOG_LEVEL=info

# URL del portal Osiptel (preparado para overrides en piloto)
OSIPTEL_PORTAL_URL=https://checatuslineas.osiptel.gob.pe/

# Pull model: el worker hace polling al backend (no necesita ser alcanzable)
BACKEND_URL=https://cobranza.contactototal.com.pe
BACKEND_TOKEN=3a1586fab5cac405e4b1ec0d8195bb50e269c02e7a154d4662deea588d110a0a
POLL_INTERVAL_MS=15000
POLL_BATCH_SIZE=3
