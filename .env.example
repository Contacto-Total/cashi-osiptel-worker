# Puerto HTTP del worker
PORT=8090

# Token compartido. El backend Java debe enviarlo en X-Worker-Token.
WORKER_TOKEN=change-me-shared-secret

# 2Captcha
TWO_CAPTCHA_KEY=your-2captcha-api-key
TWO_CAPTCHA_TIMEOUT_S=90

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_BUDGET_MS=90000

# Pool
WORKER_POOL_SIZE=3
WORKER_RECYCLE_AFTER=50

# Circuit breaker para bans
BAN_THRESHOLD=5
BAN_COOLDOWN_MS=600000

# Proxies (opcional, separados por coma)
PROXY_LIST=

# Logging
LOG_LEVEL=info

# URL del portal Osiptel (preparado para overrides en piloto)
OSIPTEL_PORTAL_URL=https://checatuslineas.osiptel.gob.pe/
